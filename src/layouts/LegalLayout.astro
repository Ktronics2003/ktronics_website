---
/**
 * LegalLayout — shared layout for Privacy, Terms, and any future policy pages.
 *
 * Compact dark hero (just title + last-updated meta), then a single-column
 * readable text body. Restrains line length to ~70ch for comfortable
 * long-form reading and tunes type sizes for body absorption rather than
 * marketing punch.
 *
 * Pass the body content through the default <slot /> as Astro children.
 *
 * SEO: doesn't aggressively pursue ranking — these pages exist for legal
 * compliance, not traffic. They stay in the index but with thin meta and
 * no FAQ/Service schema.
 */
import PageLayout from './PageLayout.astro';
import type { PageSEO } from '@lib/seo';
import { breadcrumbSchema } from '@lib/schema';
import { site } from '@lib/site';

interface Props {
  title: string;
  /** Plain-text intro shown under the H1 in the hero */
  intro?: string;
  /** Last reviewed/updated date (free text, e.g. "Reviewed April 2026") */
  lastUpdated?: string;
  seo: PageSEO;
}

const { title, intro, lastUpdated, seo } = Astro.props;

const breadcrumbs = breadcrumbSchema([
  { name: 'Home', url: `${site.url}/` },
  { name: title },
]);
---
<PageLayout seo={seo} schemaBlocks={[breadcrumbs]}>
  <section class="legal-hero on-dark">
    <div class="container">
      <h1 class="legal-title">{title}</h1>
      {intro && <p class="legal-intro">{intro}</p>}
      {lastUpdated && <p class="legal-meta">{lastUpdated}</p>}
    </div>
  </section>

  <article class="legal-body">
    <div class="container">
      <div class="legal-content">
        <slot />
      </div>
    </div>
  </article>
</PageLayout>

<style>
  .legal-hero {
    background: var(--bg-dark);
    color: var(--fg-on-dark);
    padding-block: clamp(56px, 7vw, 96px);
  }
  .legal-title {
    font-size: clamp(1.875rem, 4vw, 2.75rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.04em;
    margin: 0 0 16px;
    color: var(--fg-on-dark);
    text-wrap: balance;
  }
  .legal-intro {
    color: var(--fg-mute-on-dark);
    font-size: var(--t-lead);
    line-height: 1.6;
    margin: 0 0 16px;
    max-width: 65ch;
  }
  .legal-meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-mute-on-dark);
  }

  .legal-body {
    padding-block: clamp(64px, 8vw, 112px);
  }
  .legal-content {
    max-width: 70ch;
    margin: 0 auto;
    color: var(--ktx-ink-soft);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  /* Long-form typography — tuned for body reading, not marketing display */
  .legal-content :global(h2) {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 600;
    color: var(--ktx-ink);
    margin: 48px 0 16px;
    letter-spacing: -0.025em;
    line-height: 1.3;
  }
  .legal-content :global(h3) {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--ktx-ink);
    margin: 32px 0 12px;
    letter-spacing: -0.02em;
  }
  .legal-content :global(h2:first-child),
  .legal-content :global(h3:first-child) { margin-top: 0; }

  .legal-content :global(p) { margin: 0 0 18px; }
  .legal-content :global(ul),
  .legal-content :global(ol) {
    padding-left: 24px;
    margin: 0 0 18px;
  }
  .legal-content :global(li) { margin-bottom: 8px; }
  .legal-content :global(a) {
    color: var(--accent-text);
    border-bottom: 1px solid currentColor;
  }
  .legal-content :global(a:hover) { color: var(--accent); }
  .legal-content :global(strong) { color: var(--ktx-ink); }
  .legal-content :global(hr) {
    border: none;
    border-top: 1px solid var(--ktx-line);
    margin: 40px 0;
  }
</style>
