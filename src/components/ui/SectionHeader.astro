---
/**
 * Two-column section header: heading on the left, supporting paragraph on the right.
 * Used to introduce nearly every section (Solutions, Industries, Process, etc.).
 */
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow: string;
  heading: string;
  text?: string;
  class?: string;
}
const { eyebrow, heading, text, class: className = '' } = Astro.props;
---
<div class:list={['section-header reveal', className]}>
  <div>
    <Eyebrow>{eyebrow}</Eyebrow>
    <h2 style="margin-top:16px;" set:html={heading} />
  </div>
  {text && <p class="section-header-text" set:html={text} />}
</div>

<style>
  .section-header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: end;
    margin-bottom: 64px;
  }
  .section-header h2 { max-width: 18ch; }
  .section-header-text {
    color: var(--ktx-ink-soft);
    font-size: var(--t-lead);
    margin: 0;
  }
  @media (max-width: 800px) {
    .section-header {
      grid-template-columns: 1fr;
      gap: 24px;
      margin-bottom: 48px;
    }
  }
</style>
