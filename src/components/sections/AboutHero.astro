---
/**
 * About page hero — dark surface (matches homepage Hero pattern).
 * Two-column: editorial text on the left, team group photo on the right.
 *
 * Smaller than the homepage hero — this is "you've arrived at the About page",
 * not "welcome to Ktronics".
 */
import { Image } from 'astro:assets';
import Eyebrow from '@components/ui/Eyebrow.astro';
import teamImage from '@/assets/images/team/ktronics-team-2026.jpg';
---
<section class="about-hero on-dark">
  <div class="container">
    <div class="about-hero-grid">
      <div class="about-hero-text">
        <Eyebrow>About Ktronics</Eyebrow>
        <h1 class="about-hero-headline">
          Built around techs,<br />
          not <em>salespeople.</em>
        </h1>
        <p class="about-hero-lead">
          Twenty-two years on, we still work the same way: design what
          you&apos;ll install, install what you&apos;ve designed, maintain
          it for the life of the system. No sales team. No offshore help
          desk. When you call us, you get the people on this page.
        </p>
      </div>
      <div class="about-hero-image">
        <Image
          src={teamImage}
          alt="The Ktronics team. Sydney commercial electronic security specialists, photographed at the Brookvale workshop in 2026."
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 900px) 540px, 100vw"
          loading="eager"
          decoding="async"
          format="webp"
          quality={80}
          class="about-hero-photo"
        />
        <div class="about-hero-tag">The team / Brookvale</div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-hero {
    background: var(--bg-dark);
    color: var(--fg-on-dark);
    padding-top: 56px;
    padding-bottom: 96px;
  }
  .about-hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }

  .about-hero-headline {
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.04em;
    margin: 16px 0 24px;
    color: var(--fg-on-dark);
  }
  .about-hero-headline em {
    font-style: italic;
    font-weight: 500;
    color: var(--ktx-red);
  }
  .about-hero-lead {
    font-size: var(--t-lead);
    color: var(--fg-mute-on-dark);
    line-height: 1.55;
    max-width: 56ch;
    margin: 0;
  }

  .about-hero-image {
    position: relative;
    aspect-ratio: 1/1;        /* matches the source photo — no facial cropping */
    overflow: hidden;
    background: var(--ktx-charcoal);
  }
  .about-hero-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: grayscale(0.04) contrast(1.04);
  }
  .about-hero-tag {
    position: absolute;
    bottom: 24px;             /* moved off the faces */
    left: 24px;
    background: var(--ktx-paper);
    color: var(--ktx-ink);
    padding: 10px 14px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .about-hero-tag::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    background: var(--ktx-red);
    border-radius: 50%;
    margin-right: 8px;
    vertical-align: middle;
  }

  @media (max-width: 900px) {
    .about-hero-grid { grid-template-columns: 1fr; }
    .about-hero-image {
      aspect-ratio: 16/9;
      max-height: 360px;
      order: -1;
      margin-bottom: 24px;
    }
  }
</style>
