---
/**
 * 3x2 grid of solution cards (6 pillars). Hairline borders only — no shadows.
 * Hover: white wash, red top-rule slides in (3px), title shifts red,
 * trailing arrow translates ↗.
 *
 * Data is pulled from lib/solutions.ts so adding/removing/reordering pillars
 * propagates here without an edit. The 2-digit display number is derived
 * from each solution's `order` field.
 */
import SectionHeader from '@components/ui/SectionHeader.astro';
import { allSolutions } from '@lib/solutions';

const solutions = allSolutions();
const pad2 = (n: number) => String(n).padStart(2, '0');
---
<section id="solutions">
  <div class="container">
    <SectionHeader
      eyebrow="What we do"
      heading="Six pillars of commercial electronic security."
      text="Every site is different. Every install is custom. We design to your operations, your compliance needs, and the way your people actually work."
    />
    <div class="solutions-grid reveal">
      {solutions.map((s) => (
        <a href={`/solutions/${s.slug}/`} class="solution-card">
          <img
            class="solution-icon"
            src={s.icon}
            alt=""
            width="64"
            height="64"
            loading="lazy"
            decoding="async"
            aria-hidden="true"
          />
          <div class="solution-num">{pad2(s.order)} / {s.label}</div>
          <h3>{s.cardHeadline}</h3>
          <p>{s.shortDescription}</p>
          <div class="solution-foot">
            <span>Read more</span>
            <span class="solution-arrow" aria-hidden="true">↗</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .solutions-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--ktx-line);
    border-left: 1px solid var(--ktx-line);
  }
  .solution-card {
    padding: 36px;
    border-right: 1px solid var(--ktx-line);
    border-bottom: 1px solid var(--ktx-line);
    background: var(--ktx-paper);
    position: relative;
    transition: background 0.2s ease;
    display: flex;
    flex-direction: column;
    min-height: 280px;
  }
  .solution-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 0;
    background: var(--ktx-red);
    transition: height 0.25s var(--ease);
  }
  .solution-card:hover { background: var(--ktx-paper-hover); }
  .solution-card:hover::before { height: 3px; }
  .solution-card:hover h3 { color: var(--ktx-red); }
  .solution-card:hover .solution-arrow {
    transform: translate(4px, -4px);
    border-color: var(--ktx-red);
    color: var(--ktx-red);
  }

  .solution-icon {
    width: 56px;
    height: 56px;
    margin-bottom: 24px;
    object-fit: contain;
    transition: transform 0.25s var(--ease);
  }
  .solution-card:hover .solution-icon {
    transform: scale(1.05);
  }
  .solution-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ktx-mute);
    letter-spacing: 0.08em;
    margin-bottom: 16px;
  }
  .solution-card h3 {
    margin-bottom: 12px;
    transition: color 0.2s ease;
  }
  .solution-card p {
    color: var(--ktx-ink-soft);
    margin: 0 0 24px;
    flex-grow: 1;
  }
  .solution-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
  }
  .solution-foot span:first-child {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ktx-mute);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .solution-arrow {
    width: 32px;
    height: 32px;
    border: 1.5px solid var(--ktx-ink);
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--ktx-ink);
    transition: transform 0.25s var(--ease), color 0.2s ease, border-color 0.2s ease;
  }

  /* Tablet: 2 columns */
  @media (max-width: 1000px) {
    .solutions-grid { grid-template-columns: repeat(2, 1fr); }
  }
  /* Mobile: 1 column */
  @media (max-width: 640px) {
    .solutions-grid { grid-template-columns: 1fr; }
    .solution-card { padding: 32px; min-height: 0; }
  }
</style>
