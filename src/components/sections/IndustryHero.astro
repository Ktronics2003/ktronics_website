---
/**
 * Industry detail page hero — dark surface, scoped to one industry.
 * Same structural pattern as SolutionHero so the two page families feel
 * like the same family, with a different eyebrow + icon at the top.
 */
import Eyebrow from '@components/ui/Eyebrow.astro';
import Button from '@components/ui/Button.astro';
import type { Industry } from '@lib/industries';

interface Props {
  industry: Industry;
}
const { industry } = Astro.props;
---
<section class="industry-hero on-dark">
  <div class="container">
    <div class="industry-hero-meta">
      <Eyebrow>Industry</Eyebrow>
      <img class="industry-hero-icon" src={industry.icon} alt="" width="64" height="64" aria-hidden="true" />
    </div>

    <div class="industry-hero-grid">
      <div class="industry-hero-text">
        <h1 class="industry-hero-title">{industry.cardHeadline}</h1>
        <p class="industry-hero-lead">{industry.heroLead}</p>

        <div class="industry-hero-actions">
          <Button href="/contact/" variant="primary">Get a quote</Button>
          <Button href="/case-studies/" variant="secondary" arrow={false}>See our work</Button>
        </div>
      </div>

      <div class="industry-hero-image">
        <img
          src={industry.heroPhotoPath}
          alt={industry.heroPhotoAlt}
          width="900"
          height="1200"
          loading="eager"
          decoding="async"
          class="industry-hero-photo"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .industry-hero {
    background: var(--bg-dark);
    color: var(--fg-on-dark);
    padding-top: 56px;
    padding-bottom: 96px;
  }
  .industry-hero-meta {
    display: flex;
    align-items: center;
    gap: 24px;
    padding-bottom: 24px;
    margin-bottom: 32px;
    border-bottom: 1px solid var(--rule-on-dark);
  }
  .industry-hero-icon {
    width: 56px;
    height: 56px;
    object-fit: contain;
    /* Industry icons are charcoal line-art on transparent — invert to white on dark hero */
    filter: brightness(0) invert(1);
    opacity: 0.92;
  }

  .industry-hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }

  .industry-hero-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.04em;
    margin: 0 0 24px;
    color: var(--fg-on-dark);
    text-wrap: balance;
    max-width: 18ch;
  }
  .industry-hero-lead {
    font-size: var(--t-lead);
    color: var(--fg-mute-on-dark);
    line-height: 1.6;
    max-width: 56ch;
    margin: 0 0 32px;
  }
  .industry-hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .industry-hero-image {
    aspect-ratio: 3/4;
    overflow: hidden;
    background: var(--ktx-charcoal);
  }
  .industry-hero-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.06) contrast(1.04);
  }

  @media (max-width: 900px) {
    .industry-hero-grid { grid-template-columns: 1fr; gap: 32px; }
    .industry-hero-image { aspect-ratio: 16/9; max-height: 360px; order: -1; }
  }
</style>
