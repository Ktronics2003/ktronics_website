---
/**
 * Credentials strip — light surface, single horizontal row.
 * Surfaces the trust artefacts: ASIAL Gold Member badge, NSW Master Licence,
 * year founded, ABN. Quiet styling — these are facts, not boasts.
 */
import { site } from '@lib/site';
---
<section class="credentials">
  <div class="container">
    <ul class="cred-grid">
      <li class="cred-item cred-item--badge">
        <a href="https://www.asial.com.au" target="_blank" rel="noopener" aria-label="ASIAL Gold Member">
          <img
            src="/images/asial-gold-member.png"
            alt="ASIAL Gold Member, Australian Security Industry Association Limited"
            width="600"
            height="480"
            loading="lazy"
          />
        </a>
      </li>
      <li class="cred-item">
        <span class="cred-label">NSW Master Licence</span>
        <strong class="cred-value">{site.credentials.nswMasterLicence}</strong>
      </li>
      <li class="cred-item">
        <span class="cred-label">Founded</span>
        <strong class="cred-value">{site.founded}</strong>
      </li>
      {site.credentials.abn && (
        <li class="cred-item">
          <span class="cred-label">ABN</span>
          <strong class="cred-value">{site.credentials.abn}</strong>
        </li>
      )}
    </ul>
  </div>
</section>

<style>
  .credentials {
    background: var(--bg-alt);
    padding-block: clamp(48px, 6vw, 72px);
  }
  .cred-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: auto repeat(3, 1fr);
    gap: 32px 48px;
    align-items: center;
  }
  .cred-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .cred-item--badge {
    background: white;
    padding: 12px 16px;
    border-radius: 4px;
    line-height: 0;
    width: max-content;
  }
  .cred-item--badge img {
    height: 64px;
    width: auto;
  }
  .cred-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ktx-mute);
  }
  .cred-value {
    font-family: var(--font-mono);
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--ktx-ink);
    letter-spacing: 0.04em;
  }

  @media (max-width: 800px) {
    .cred-grid { grid-template-columns: 1fr 1fr; gap: 24px 32px; }
    .cred-item--badge { grid-column: 1 / -1; }
  }
</style>
