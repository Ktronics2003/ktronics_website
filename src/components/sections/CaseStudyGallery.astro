---
/**
 * Case Study image gallery — variable-count tile grid.
 *
 * Visual treatment matches the homepage CraftGallery (hover tag reveal,
 * subtle scale-on-hover) so the two galleries feel like the same family
 * of components.
 *
 * Layout adapts to the number of images:
 *   - 4 images → 2x2 grid
 *   - 6 images → 3x2 grid (the pharma case)
 *   - 8 images → 4x2 grid
 * We keep all tiles equal-sized for legibility; the masonry treatment is
 * reserved for the homepage Craft Gallery.
 */
import Eyebrow from '@components/ui/Eyebrow.astro';
import type { CaseStudyImage } from '@lib/caseStudies';

interface Props {
  images: CaseStudyImage[];
  eyebrow?: string;
  heading?: string;
}
const {
  images,
  eyebrow = 'On site',
  heading = 'A look at the install.',
} = Astro.props;
---
<section class="cs-gallery">
  <div class="container">
    <div class="cs-gallery-header reveal">
      <Eyebrow>{eyebrow}</Eyebrow>
      <h2 class="cs-gallery-heading">{heading}</h2>
    </div>

    <ul class="cs-gallery-grid reveal" data-count={images.length}>
      {images.map((img) => (
        <li class="cs-tile">
          <figure>
            <img
              src={img.src}
              alt={img.alt}
              loading="lazy"
              decoding="async"
              class="cs-photo"
            />
            {img.tag && <figcaption class="cs-tag">{img.tag}</figcaption>}
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cs-gallery {
    background: var(--bg-alt);
    padding-block: clamp(80px, 10vw, 128px);
  }
  .cs-gallery-header {
    margin-bottom: 48px;
    max-width: 60ch;
  }
  .cs-gallery-heading {
    margin: 16px 0 0;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  .cs-gallery-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  /* 4 images → 2x2 */
  .cs-gallery-grid[data-count="4"] {
    grid-template-columns: repeat(2, 1fr);
  }
  /* 8 images → 4 across */
  .cs-gallery-grid[data-count="8"] {
    grid-template-columns: repeat(4, 1fr);
  }

  .cs-tile {
    margin: 0;
  }
  .cs-tile figure {
    margin: 0;
    position: relative;
    overflow: hidden;
    background: var(--ktx-charcoal);
    aspect-ratio: 4/3;
  }
  .cs-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.08) contrast(1.04);
    transition: transform 0.5s var(--ease), filter 0.4s ease;
  }
  .cs-tile:hover .cs-photo {
    transform: scale(1.04);
    filter: grayscale(0) contrast(1.06);
  }
  .cs-tag {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background: var(--ktx-paper);
    color: var(--ktx-ink);
    padding: 6px 10px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease);
    pointer-events: none;
  }
  .cs-tile:hover .cs-tag,
  .cs-tile:focus-within .cs-tag {
    opacity: 1;
    transform: translateY(0);
  }
  /* Touch devices: always show the tag */
  @media (hover: none) {
    .cs-tag { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 800px) {
    .cs-gallery-grid,
    .cs-gallery-grid[data-count="4"],
    .cs-gallery-grid[data-count="8"] {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 480px) {
    .cs-gallery-grid,
    .cs-gallery-grid[data-count="4"],
    .cs-gallery-grid[data-count="8"] {
      grid-template-columns: 1fr;
    }
    .cs-tile figure { aspect-ratio: 16/10; }
  }
</style>
