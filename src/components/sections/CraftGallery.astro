---
/**
 * Craft Gallery — a curated strip of install detail shots.
 * Celebrates the technical craftsmanship: clean cabling, neatly populated
 * panels, structured comms racks. The photos do the talking — minimal copy.
 *
 * Layout: irregular masonry-style grid (1 large + 4 smaller) on desktop,
 * collapses to a 2-col grid then 1-col on phone.
 *
 * Photos are imported from src/assets/images so Astro generates AVIF/WebP
 * with srcset.
 */
import { Image } from 'astro:assets';
import SectionHeader from '@components/ui/SectionHeader.astro';
import Button from '@components/ui/Button.astro';

import shotHero from '@/assets/images/details/detail-comms-rack-fitout.jpg';
import shotControl from '@/assets/images/details/tech-installing-access-control-board.jpg';
import shotCabling from '@/assets/images/details/detail-comms-rack-green-cabling.jpg';
import shotCableTray from '@/assets/images/details/detail-overhead-cable-tray.jpg';
import shotAlarm from '@/assets/images/details/detail-alarm-intrusion-control-panel.jpg';

interface GalleryShot {
  src: ImageMetadata;
  alt: string;
  tag: string;
  size: 'lg' | 'sm';
}

// 5 tiles fits the 4-col x 2-row grid perfectly: 1 large (2x2) + 4 small (1x1).
const shots: GalleryShot[] = [
  {
    src: shotHero,
    alt: 'Newly installed comms rack with structured cabling, awaiting hand-off at a Sydney commercial site',
    tag: 'Comms rack / fit-out',
    size: 'lg',
  },
  {
    src: shotControl,
    alt: 'Ktronics technician commissioning an access control board with a multimeter',
    tag: 'Access control / commissioning',
    size: 'sm',
  },
  {
    src: shotCabling,
    alt: 'Tidy fibre cabling routed into a black 19-inch rack',
    tag: 'Fibre patch / rack',
    size: 'sm',
  },
  {
    src: shotCableTray,
    alt: 'Overhead cable tray installed across a warehouse ceiling',
    tag: 'Cable tray / warehouse',
    size: 'sm',
  },
  {
    src: shotAlarm,
    alt: 'Intrusion alarm panel with backup battery, neatly wired into a steel enclosure',
    tag: 'Intrusion / alarm',
    size: 'sm',
  },
];
---
<section class="craft">
  <div class="container">
    <SectionHeader
      eyebrow="Inside the work"
      heading="The bits clients never see, done properly anyway."
      text="Every install passes through the same standard, whether the client opens the cabinet daily or never. Tidy looms, labelled cores, future-proof fit-outs. Pride in the craft is built into the price."
    />

    <div class="craft-grid reveal">
      {shots.map((s) => (
        <figure class:list={['craft-tile', `craft-tile--${s.size}`]}>
          <Image
            src={s.src}
            alt={s.alt}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 33vw, 100vw"
            loading="lazy"
            decoding="async"
            format="webp"
            quality={78}
            class="craft-photo"
          />
          <figcaption class="craft-tag">{s.tag}</figcaption>
        </figure>
      ))}
    </div>

    <div class="craft-cta">
      <Button href="/case-studies/" variant="secondary">See more of our work</Button>
    </div>
  </div>
</section>

<style>
  .craft {
    padding-top: clamp(80px, 10vw, 128px);
    padding-bottom: clamp(56px, 6vw, 80px);  /* tightened — testimonial follows */
  }

  .craft-grid {
    display: grid;
    /* 4 cols, 2 rows; first tile spans 2x2 to anchor the composition. */
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 220px;
    gap: 16px;
  }
  .craft-tile {
    margin: 0;
    position: relative;
    overflow: hidden;
    background: var(--ktx-ink);
  }
  .craft-tile--lg {
    grid-column: span 2;
    grid-row: span 2;
  }
  .craft-tile--sm {
    grid-column: span 1;
    grid-row: span 1;
  }
  .craft-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.08) contrast(1.04);
    transition: transform 0.5s var(--ease), filter 0.4s ease;
  }
  .craft-tile:hover .craft-photo {
    transform: scale(1.04);
    filter: grayscale(0) contrast(1.06);
  }
  .craft-tag {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background: var(--ktx-paper);
    color: var(--ktx-ink);
    padding: 6px 10px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease);
    pointer-events: none;
  }
  .craft-tile:hover .craft-tag,
  .craft-tile:focus-within .craft-tag {
    opacity: 1;
    transform: translateY(0);
  }

  /* Always show tag on touch devices (no hover) */
  @media (hover: none) {
    .craft-tag { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 900px) {
    .craft-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 180px;
    }
    .craft-tile--lg {
      grid-column: span 2;
      grid-row: span 2;
    }
  }
  @media (max-width: 480px) {
    .craft-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 240px;
    }
    .craft-tile--lg,
    .craft-tile--sm {
      grid-column: span 1;
      grid-row: span 1;
    }
  }

  /* CTA strip below the grid */
  .craft-cta {
    display: flex;
    justify-content: center;
    margin-top: 48px;
  }
</style>
