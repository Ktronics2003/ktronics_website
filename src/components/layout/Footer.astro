---
/**
 * Site footer — dark (--ktx-black), 2px red top rule, three content columns
 * + brand column. Address, licence, and emergency line use mono treatment.
 */
import Logo from '@components/ui/Logo.astro';
import { site } from '@lib/site';

const year = new Date().getFullYear();
---
<footer>
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo variant="light" height={42} class="logo--footer" />
        <p>
          Commercial electronic security solutions for Sydney businesses.
          Designed, installed, and maintained since {site.founded}.
        </p>
        <address class="footer-creds">
          <strong>{site.legalName}</strong>
          <span>{site.address.streetAddress}</span>
          <span>{site.address.locality} {site.address.region} {site.address.postalCode}</span>
        </address>
        <div class="footer-licence">
          <span class="footer-licence-label">NSW Master Licence</span>
          <strong>{site.credentials.nswMasterLicence}</strong>
        </div>
        <a class="footer-asial" href="https://www.asial.com.au" target="_blank" rel="noopener" aria-label="ASIAL Gold Member, Australian Security Industry Association Limited">
          <img src="/images/asial-gold-member.png" alt="ASIAL Gold Member, Australian Security Industry Association Limited" width="600" height="480" loading="lazy" />
        </a>
      </div>

      <div class="footer-col">
        <h4>Solutions</h4>
        <ul>
          <li><a href="/solutions/access-control/">Access Control</a></li>
          <li><a href="/solutions/intercoms/">Intercoms</a></li>
          <li><a href="/solutions/video-surveillance/">Video Surveillance</a></li>
          <li><a href="/solutions/alarms/">Alarms</a></li>
          <li><a href="/solutions/visitor-management/">Visitor Management</a></li>
          <li><a href="/solutions/maintenance-monitoring/">Maintenance &amp; Monitoring</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Additional Services</h4>
        <ul>
          <li><a href="/additional-services/test-and-tag/">Test &amp; Tag</a></li>
          <li><a href="/additional-services/structured-data-cabling/">Structured Data Cabling</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Company</h4>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/case-studies/">Our work</a></li>
          <li><a href="/careers/">Careers</a></li>
          <li><a href="/resources/">Resources</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Get in touch</h4>
        <ul>
          <li><a href={`tel:${site.contact.phone.replace(/\s+/g, '')}`}>{site.contact.phone}</a></li>
          <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
          <li class="footer-meta">{site.hours.display}</li>
          <li class="footer-meta">24/7 emergency: {site.contact.emergencyPhone}</li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} {site.legalName}. All rights reserved.</span>
      <span class="footer-legal-links">
        <a href="/privacy-policy/">Privacy</a>
        <a href="/terms/">Terms</a>
      </span>
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--bg-dark);
    color: var(--fg-mute-on-dark);
    padding-top: 96px;
    padding-bottom: 32px;
    position: relative;
  }
  footer::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--ktx-red);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 48px;
    padding-bottom: 64px;
    border-bottom: 1px solid var(--rule-on-dark);
  }
  .footer-brand .logo--footer { display: block; margin-bottom: 24px; }
  .footer-brand p {
    color: var(--fg-mute-on-dark);
    font-size: 0.9375rem;
    max-width: 36ch;
    margin: 0 0 24px;
  }
  .footer-creds {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--fg-mute-on-dark);
    line-height: 1.7;
    font-style: normal;
    display: flex;
    flex-direction: column;
    margin-bottom: 16px;
  }
  .footer-creds strong { color: var(--fg-on-dark); font-weight: 500; }

  .footer-licence {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 16px;
    border-top: 1px solid var(--rule-on-dark);
    font-family: var(--font-mono);
  }
  .footer-licence-label {
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-mute-on-dark);
  }
  .footer-licence strong {
    font-size: 0.9375rem;
    color: var(--fg-on-dark);
    font-weight: 500;
    letter-spacing: 0.05em;
  }
  /* ASIAL badge — small white card sits clean against dark footer */
  .footer-asial {
    display: inline-block;
    margin-top: 20px;
    background: white;
    padding: 10px 14px;
    border-radius: 4px;
    line-height: 0;
    transition: transform 0.18s var(--ease);
  }
  .footer-asial:hover { transform: translateY(-1px); }
  .footer-asial img {
    height: 56px;
    width: auto;
    display: block;
  }

  .footer-col h4 {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-on-dark);
    font-weight: 500;
    margin: 0 0 20px;
  }
  .footer-col ul { list-style: none; padding: 0; margin: 0; }
  .footer-col li { margin-bottom: 10px; }
  .footer-col a {
    color: var(--fg-mute-on-dark);
    font-size: 0.9375rem;
    transition: color 0.18s ease;
  }
  .footer-col a:hover { color: var(--ktx-red); }
  .footer-meta {
    color: var(--fg-mute-on-dark);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 32px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-mute-on-dark);
    letter-spacing: 0.05em;
  }
  .footer-legal-links a { color: inherit; margin-left: 24px; }
  .footer-legal-links a:first-child { margin-left: 0; margin-right: 24px; }

  @media (max-width: 800px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
    .footer-brand { grid-column: 1 / -1; }
    .footer-bottom {
      flex-direction: column;
      gap: 16px;
      align-items: flex-start;
    }
  }
</style>
