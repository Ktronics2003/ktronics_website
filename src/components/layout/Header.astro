---
/**
 * Site header — sticky charcoal bar with backdrop blur, red structural rule
 * appears on scroll.
 *
 * Nav items can carry a `children` array for dropdown menus. Currently only
 * Solutions has children (pulled live from solutions.ts so future additions
 * appear automatically). Industries can be wired the same way once those
 * detail pages exist.
 *
 * Mobile (≤960px): hamburger trigger opens a full-screen charcoal overlay
 * with the same nav items rendered as a flat stack. Items with children
 * render their sub-items as an indented list (no extra interaction needed).
 */
import Logo from '@components/ui/Logo.astro';
import { site } from '@lib/site';
import { allSolutions } from '@lib/solutions';
import { allIndustries } from '@lib/industries';
import { allAdditionalServices } from '@lib/additionalServices';

interface NavChild { label: string; href: string }
interface NavItem { label: string; href: string; children?: NavChild[] }

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

// Augment the static primary nav with computed children for items that have
// detail pages (Solutions + Industries). The "All ..." leading entry routes
// back to the hub; the rest are the individual pages. Children are computed
// live from their data files so additions appear automatically.
// Solutions dropdown holds all six security pillars plus the two add-on
// services (Test & Tag, Data Cabling) at the bottom. Add-ons live at
// /additional-services/* URLs but appear under the Solutions nav per the
// product framing decision (one nav menu, not two).
const solutionChildren: NavChild[] = [
  { label: 'All solutions', href: '/solutions/' },
  ...allSolutions().map((s) => ({ label: s.label, href: `/solutions/${s.slug}/` })),
  ...allAdditionalServices().map((s) => ({ label: s.label, href: `/additional-services/${s.slug}/` })),
];
const industryChildren: NavChild[] = [
  { label: 'All industries', href: '/industries/' },
  ...allIndustries().map((i) => ({ label: i.label, href: `/industries/${i.slug}/` })),
];

const navItems: NavItem[] = site.primaryNav.map((item) => {
  if (item.label === 'Solutions')  return { ...item, children: solutionChildren };
  if (item.label === 'Industries') return { ...item, children: industryChildren };
  return { ...item };
});

// Helper: stable kebab id per item label for ARIA controls
const slugId = (label: string) =>
  'nav-menu-' + label.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---
<header class="header" id="site-header">
  <div class="container header-inner">
    <Logo variant="light" height={40} class="logo--header" />

    <nav class="nav" aria-label="Primary">
      {navItems.map((item) => (
        item.children ? (
          <div class="nav-item nav-item--has-menu" data-nav-dropdown>
            <button
              class="nav-trigger"
              type="button"
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls={slugId(item.label)}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
              <span class="nav-chevron" aria-hidden="true">
                <svg viewBox="0 0 12 8" width="10" height="7" fill="none" stroke="currentColor" stroke-width="1.6">
                  <path d="M1 1.5L6 6.5L11 1.5" />
                </svg>
              </span>
            </button>
            <div class="nav-menu" id={slugId(item.label)} role="menu" hidden>
              <ul>
                {item.children.map((child) => (
                  <li role="none">
                    <a
                      href={child.href}
                      role="menuitem"
                      aria-current={currentPath === child.href ? 'page' : undefined}
                    >{child.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class="nav-link"
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >{item.label}</a>
        )
      ))}
    </nav>

    <div class="header-cta">
      <span class="header-cta-label">Sydney • Call</span>
      <a href={`tel:${site.contact.phone.replace(/\s+/g, '')}`}>{site.contact.phone}</a>
    </div>

    <button
      class="hamburger"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-mobile-toggle
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
  </div>

  <!-- Full-screen mobile overlay -->
  <div class="mobile-nav" id="mobile-nav" role="dialog" aria-label="Mobile navigation" aria-modal="true" hidden>
    <div class="mobile-nav-inner">
      <ul class="mobile-nav-list">
        {navItems.map((item) => (
          <li>
            <a href={item.href} class="mobile-nav-link">{item.label}</a>
            {item.children && (
              <ul class="mobile-nav-sublist">
                {item.children
                  /* Hub is implicit (the parent label links to it) — drop it from the sub-list */
                  .filter((c) => c.href !== item.href)
                  .map((child) => (
                    <li><a href={child.href}>{child.label}</a></li>
                  ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <div class="mobile-nav-foot">
        <span class="header-cta-label">Sydney • Call</span>
        <a class="mobile-nav-phone" href={`tel:${site.contact.phone.replace(/\s+/g, '')}`}>{site.contact.phone}</a>
      </div>
    </div>
  </div>
</header>

<style>
  /* ---------- Header shell ---------- */
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(27, 29, 32, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 2px solid transparent;
    transition: border-color 0.2s ease, background 0.2s ease;
    color: var(--fg-on-dark);
  }
  .header.scrolled {
    border-bottom-color: var(--ktx-red);
    background: rgba(27, 29, 32, 0.98);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 18px;
    gap: 32px;
  }

  /* ---------- Desktop nav ---------- */
  .nav {
    display: flex;
    align-items: center;
    gap: 36px;
  }
  .nav-link,
  .nav-trigger {
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--fg-on-dark);
    background: none;
    border: none;
    padding: 4px 0;
    cursor: pointer;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.18s ease;
  }
  .nav-link::after,
  .nav-trigger::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    background: var(--ktx-red);
    transition: width 0.2s var(--ease);
  }
  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after,
  .nav-trigger:hover::after,
  .nav-trigger[aria-current="page"]::after,
  .nav-item--has-menu:focus-within > .nav-trigger::after { width: 100%; }

  .nav-chevron {
    display: inline-flex;
    transition: transform 0.2s ease;
  }
  .nav-trigger[aria-expanded="true"] .nav-chevron { transform: rotate(180deg); }

  /* ---------- Dropdown menu ---------- */
  .nav-item--has-menu {
    position: relative;
  }
  .nav-menu {
    position: absolute;
    top: calc(100% + 12px);
    left: -16px;
    min-width: 240px;
    background: var(--ktx-charcoal);
    border: 1px solid var(--rule-on-dark);
    border-top: 2px solid var(--ktx-red);
    padding: 8px 0;
    z-index: 110;
    /* Animate in via opacity/translate so it doesn't pop */
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.18s var(--ease), transform 0.18s var(--ease);
    pointer-events: none;
  }
  .nav-menu[hidden] { display: none; }
  .nav-menu:not([hidden]) {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .nav-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-menu a {
    display: block;
    padding: 10px 20px;
    font-size: 0.9375rem;
    color: var(--fg-on-dark);
    transition: background 0.15s ease, color 0.15s ease;
  }
  .nav-menu a:hover,
  .nav-menu a:focus-visible {
    background: rgba(229, 24, 56, 0.12);
    color: var(--ktx-red);
    outline: none;
  }
  .nav-menu a[aria-current="page"] {
    color: var(--ktx-red);
  }

  /* ---------- Header CTA (right side) ---------- */
  .header-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    border-left: 1px solid var(--rule-on-dark);
    padding-left: 24px;
  }
  .header-cta-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--fg-mute-on-dark);
  }
  .header-cta a {
    font-family: var(--font-mono);
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--fg-on-dark);
  }
  .header-cta a:hover { color: var(--ktx-red); }

  /* ---------- Hamburger ---------- */
  .hamburger {
    display: none;
    width: 32px;
    height: 32px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
  }
  .hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--fg-on-dark);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  /* ---------- Mobile overlay ---------- */
  .mobile-nav {
    position: fixed;
    inset: 0;
    background: var(--ktx-charcoal);
    color: var(--fg-on-dark);
    z-index: 99;
    display: none;
    overflow-y: auto;
  }
  .mobile-nav[hidden] { display: none; }
  .mobile-nav.is-open { display: block; }
  .mobile-nav-inner {
    min-height: 100%;
    padding: 96px var(--gutter) 48px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 48px;
  }
  .mobile-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .mobile-nav-link {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 7vw, 2.5rem);
    font-weight: 600;
    color: var(--fg-on-dark);
    letter-spacing: -0.02em;
  }
  .mobile-nav-sublist {
    list-style: none;
    margin: 12px 0 0;
    padding: 12px 0 0 16px;
    border-left: 2px solid var(--ktx-red);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .mobile-nav-sublist a {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    color: var(--fg-mute-on-dark);
    transition: color 0.15s ease;
  }
  .mobile-nav-sublist a:hover { color: var(--ktx-red); }

  .mobile-nav-foot {
    border-top: 1px solid var(--rule-on-dark);
    padding-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .mobile-nav-phone {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    color: var(--fg-on-dark);
  }

  @media (max-width: 960px) {
    .nav,
    .header-cta-label,
    .header-cta { display: none; }
    .hamburger { display: inline-flex; }
  }
</style>

<script>
  // -----------------------------------------------------------------------
  // Border-on-scroll
  // -----------------------------------------------------------------------
  const header = document.getElementById('site-header');
  if (header) {
    const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // -----------------------------------------------------------------------
  // Desktop nav dropdowns
  // -----------------------------------------------------------------------
  // Each dropdown is a <button> trigger + <div role="menu"> panel.
  // Behaviour:
  //   - Click trigger to toggle (touch + keyboard primary path)
  //   - Hover opens / leave closes (with small delay so it doesn't snap shut
  //     when the cursor traverses the gap between trigger and panel)
  //   - Escape closes + restores focus to trigger
  //   - Outside click closes
  //   - Only one dropdown open at a time
  // -----------------------------------------------------------------------
  const dropdowns = document.querySelectorAll<HTMLElement>('[data-nav-dropdown]');

  const closeAll = (except?: HTMLElement) => {
    dropdowns.forEach((dd) => {
      if (dd === except) return;
      const trig = dd.querySelector<HTMLButtonElement>('.nav-trigger');
      const menu = dd.querySelector<HTMLElement>('.nav-menu');
      if (trig && menu) {
        trig.setAttribute('aria-expanded', 'false');
        menu.setAttribute('hidden', '');
      }
    });
  };

  dropdowns.forEach((dd) => {
    const trig = dd.querySelector<HTMLButtonElement>('.nav-trigger');
    const menu = dd.querySelector<HTMLElement>('.nav-menu');
    if (!trig || !menu) return;

    let leaveTimer: number | undefined;

    const open = () => {
      window.clearTimeout(leaveTimer);
      closeAll(dd);
      trig.setAttribute('aria-expanded', 'true');
      menu.removeAttribute('hidden');
    };
    const close = () => {
      trig.setAttribute('aria-expanded', 'false');
      menu.setAttribute('hidden', '');
    };
    const scheduleClose = () => {
      window.clearTimeout(leaveTimer);
      leaveTimer = window.setTimeout(close, 160);
    };
    const cancelClose = () => window.clearTimeout(leaveTimer);

    // Click toggles
    trig.addEventListener('click', () => {
      const expanded = trig.getAttribute('aria-expanded') === 'true';
      expanded ? close() : open();
    });

    // Hover open / leave-with-delay close
    dd.addEventListener('mouseenter', open);
    dd.addEventListener('mouseleave', scheduleClose);
    dd.addEventListener('focusin', cancelClose);

    // Escape closes + restores focus
    dd.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        close();
        trig.focus();
      }
    });
  });

  // Outside click closes any open dropdown
  document.addEventListener('click', (e) => {
    const target = e.target as Element;
    if (!target.closest('[data-nav-dropdown]')) closeAll();
  });

  // -----------------------------------------------------------------------
  // Mobile nav overlay toggle
  // -----------------------------------------------------------------------
  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const overlay = document.getElementById('mobile-nav');
  if (toggle && overlay) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      overlay.classList.toggle('is-open', open);
      overlay.toggleAttribute('hidden', !open);
      document.body.style.overflow = open ? 'hidden' : '';
    };
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      setOpen(open);
    });
    overlay.addEventListener('click', (e) => {
      if (e.target instanceof HTMLAnchorElement) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }
</script>
