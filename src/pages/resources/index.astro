---
/**
 * /resources/ — hub page.
 *
 * Three destinations:
 *   - Blog (recent posts)
 *   - FAQs (canonical strategic Qs)
 *   - Buyer's guide (PDF lead magnet — placeholder card until the PDF lands)
 */
import PageLayout from '@layouts/PageLayout.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import CtaBlock from '@components/sections/CtaBlock.astro';
import { breadcrumbSchema } from '@lib/schema';
import { communityPosts, articlePosts } from '@lib/blog';
import { site } from '@lib/site';

// Two streams: community/events stories + general buying-guide articles.
// Showing up to 3 of each so the hub stays a single quick scroll.
const community = communityPosts(3);
const articles  = articlePosts(3);

const seo = {
  title: 'Commercial Security Resources Sydney | Ktronics',
  description:
    "Commercial security resources for Sydney businesses: CCTV pricing benchmarks, access control comparisons, NSW Master Licence and ASIAL compliance explainers, FAQs.",
  path: '/resources/',
};

const breadcrumbs = breadcrumbSchema([
  { name: 'Home', url: `${site.url}/` },
  { name: 'Resources' },
]);
---
<PageLayout seo={seo} schemaBlocks={[breadcrumbs]}>
  {/* ----- Hero ----- */}
  <section class="resources-hero on-dark">
    <div class="container">
      <Eyebrow>Resources</Eyebrow>
      <h1 class="resources-title">
        Commercial security in Sydney:<br />
        buying guides, FAQs, and<br />
        <em>pricing benchmarks.</em>
      </h1>
      <p class="resources-lead">
        Plain-English answers to the questions Sydney commercial security
        buyers actually ask. CCTV cost ranges, access control comparisons,
        NSW Master Licence and ASIAL compliance explainers, and the things
        to check before signing any quote. Written by Ktronics, ASIAL Gold
        Member and NSW Master Licence 102039, in business since 2003.
      </p>
    </div>
  </section>

  {/* ----- Three resource cards ----- */}
  <section class="resources-grid-section">
    <div class="container">
      <ul class="resources-grid">
        <li class="resource-card">
          <a href="/resources/blog/">
            <span class="resource-eyebrow">Articles</span>
            <h2 class="resource-card-title">Blog</h2>
            <p class="resource-card-body">
              Buying guides, compliance explainers, and practical articles
              on commercial electronic security. New posts as they&apos;re
              written.
            </p>
            <span class="resource-card-cta">Read the blog <span aria-hidden="true">↗</span></span>
          </a>
        </li>

        <li class="resource-card">
          <a href="/resources/faqs/">
            <span class="resource-eyebrow">Common questions</span>
            <h2 class="resource-card-title">Frequently asked</h2>
            <p class="resource-card-body">
              The cross-cutting questions buyers ask before signing. Pricing,
              compliance, monitoring, lifecycle, and what to look for in any
              installer.
            </p>
            <span class="resource-card-cta">Read the FAQs <span aria-hidden="true">↗</span></span>
          </a>
        </li>

        <li class="resource-card">
          <a href="/downloads/ktronics-capability-statement-2026.pdf" download>
            <span class="resource-eyebrow">PDF download</span>
            <h2 class="resource-card-title">Capability statement</h2>
            <p class="resource-card-body">
              A 7-page PDF you can forward inside your organisation when
              scoping a commercial security project. Who we are, what we
              install, sectors we serve, and 20+ year track record.
            </p>
            <span class="resource-card-cta">Download (PDF, ~1.8 MB) <span aria-hidden="true">↓</span></span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  {/* ----- Two-row blog feed: Community first, Articles below -----
       The Community row leads because people + events stories convey the
       "who we are" signal a buyer wants before reading dense buying guides. */}
  {community.length > 0 && (
    <section class="recent-posts-section">
      <div class="container">
        <div class="recent-header">
          <Eyebrow>Ktronics in the community</Eyebrow>
          <h2 class="recent-heading">People, events, and the industry.</h2>
        </div>

        <ul class="recent-grid">
          {community.map((p) => (
            <li>
              <a href={`/resources/blog/${p.slug}/`}>
                <div class="recent-image">
                  <img src={p.heroImage} alt={p.heroImageAlt} loading="lazy" decoding="async" />
                </div>
                <div class="recent-meta">
                  <span class="recent-tag">{p.tags[0]}</span>
                  <h3 class="recent-title">{p.title}</h3>
                  <p class="recent-excerpt">{p.excerpt}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {articles.length > 0 && (
    <section class="recent-posts-section recent-posts-section--articles">
      <div class="container">
        <div class="recent-header">
          <Eyebrow>Articles &amp; guides</Eyebrow>
          <h2 class="recent-heading">Buying guides and explainers.</h2>
        </div>

        <ul class="recent-grid">
          {articles.map((p) => (
            <li>
              <a href={`/resources/blog/${p.slug}/`}>
                <div class="recent-image">
                  <img src={p.heroImage} alt={p.heroImageAlt} loading="lazy" decoding="async" />
                </div>
                <div class="recent-meta">
                  <span class="recent-tag">{p.tags[0]}</span>
                  <h3 class="recent-title">{p.title}</h3>
                  <p class="recent-excerpt">{p.excerpt}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>

        <p class="recent-more">
          <a href="/resources/blog/">See all articles <span aria-hidden="true">↗</span></a>
        </p>
      </div>
    </section>
  )}

  <CtaBlock
    heading="Got a question we haven&apos;t answered? <em>Just ask.</em>"
    buttonText="Get in touch"
  />
</PageLayout>

<style>
  /* ----- Hero ----- */
  .resources-hero {
    background: var(--bg-dark);
    color: var(--fg-on-dark);
    padding-block: clamp(72px, 9vw, 128px);
  }
  .resources-title {
    margin: 16px 0 24px;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--fg-on-dark);
    text-wrap: balance;
  }
  .resources-title em { font-style: italic; font-weight: 500; color: var(--ktx-red); }
  .resources-lead {
    color: var(--fg-mute-on-dark);
    font-size: var(--t-lead);
    line-height: 1.6;
    max-width: 64ch;
    margin: 0;
  }

  /* ----- Resource cards ----- */
  .resources-grid-section { padding-block: clamp(80px, 10vw, 128px); }
  .resources-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--ktx-line);
    border-left: 1px solid var(--ktx-line);
  }
  .resource-card a {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 36px 32px;
    border-right: 1px solid var(--ktx-line);
    border-bottom: 1px solid var(--ktx-line);
    background: var(--bg);
    transition: background 0.2s ease;
    position: relative;
  }
  .resource-card a::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 0;
    background: var(--ktx-red);
    transition: height 0.25s var(--ease);
  }
  .resource-card a:hover { background: var(--ktx-paper-hover); }
  .resource-card a:hover::before { height: 3px; }
  .resource-card a:hover .resource-card-title { color: var(--ktx-red); }
  .resource-card a:hover .resource-card-cta { color: var(--ktx-red); }

  .resource-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-text);
    display: block;
    margin-bottom: 16px;
  }
  .resource-card-title {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    margin: 0 0 12px;
    transition: color 0.2s ease;
  }
  .resource-card-body {
    color: var(--ktx-ink-soft);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0 0 24px;
    flex-grow: 1;
  }
  .resource-card-cta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ktx-mute);
    transition: color 0.2s ease;
  }

  @media (max-width: 800px) {
    .resources-grid { grid-template-columns: 1fr; }
  }

  /* ----- Recent posts (two-row feed: Community + Articles) -----
     Stacked sections, alternating tone. Community sits on the alt-paper
     surface so it reads as the "warmer" social section; Articles drops back
     to the body paper so the typography of each grid stays the focus. */
  .recent-posts-section {
    padding-block: clamp(56px, 7vw, 88px);
    background: var(--bg-alt);
  }
  .recent-posts-section--articles {
    background: var(--bg);
    padding-top: clamp(40px, 5vw, 64px);
  }
  .recent-more {
    margin: 32px 0 0;
    text-align: right;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .recent-more a {
    color: var(--accent-text);
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }
  .recent-more a:hover { color: var(--accent); }
  .recent-header {
    margin-bottom: 40px;
    max-width: 60ch;
  }
  .recent-heading {
    margin: 16px 0 0;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.035em;
  }
  .recent-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .recent-grid a {
    display: block;
    background: var(--bg);
    border: 1px solid var(--ktx-line);
    transition: border-color 0.2s ease;
  }
  .recent-grid a:hover { border-color: var(--ktx-red); }
  .recent-grid a:hover .recent-title { color: var(--ktx-red); }
  .recent-grid a:hover .recent-image img { transform: scale(1.03); }
  .recent-image {
    aspect-ratio: 16/9;
    overflow: hidden;
    background: var(--ktx-charcoal);
  }
  .recent-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }
  .recent-meta { padding: 16px 20px 20px; }
  .recent-tag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-text);
    display: block;
    margin-bottom: 8px;
  }
  .recent-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.025em;
    margin: 0 0 8px;
    transition: color 0.2s ease;
    text-wrap: balance;
  }
  .recent-excerpt {
    font-size: 0.875rem;
    color: var(--ktx-ink-soft);
    line-height: 1.55;
    margin: 0;
  }
  @media (max-width: 800px) {
    .recent-grid { grid-template-columns: 1fr; }
  }
</style>
