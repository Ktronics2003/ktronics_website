---
/**
 * /case-studies/pharma-distribution-western-sydney/
 *
 * Anchor case study — currently the only published one. All content lives
 * in src/lib/caseStudies.ts so future case studies follow the same pattern:
 * add an entry to the data file + create a thin page like this one.
 *
 * Composition:
 *   CaseStudyHero (dark)        — title + meta strip + hero image
 *   CaseStudyBody (light)       — Brief / Solution / Outcome editorial
 *   CaseStudyStats (dark)       — 40 doors / 200+ cameras / 24/7 monitored
 *   CaseStudyGallery (paper-2)  — 6 install photos
 *   Testimonial (light)         — anonymous client quote
 *   CtaBlock (dark)             — closing CTA
 *
 * Schema:
 *   - Article JSON-LD describing the case study (good for AI search citations)
 *   - BreadcrumbList
 *   - Organization + LocalBusiness via BaseLayout
 */
import PageLayout from '@layouts/PageLayout.astro';
import CaseStudyHero from '@components/sections/CaseStudyHero.astro';
import CaseStudyBody from '@components/sections/CaseStudyBody.astro';
import CaseStudyStats from '@components/sections/CaseStudyStats.astro';
import CaseStudyGallery from '@components/sections/CaseStudyGallery.astro';
import Testimonial from '@components/sections/Testimonial.astro';
import CtaBlock from '@components/sections/CtaBlock.astro';
import { breadcrumbSchema } from '@lib/schema';
import { getCaseStudy } from '@lib/caseStudies';
import { site } from '@lib/site';

const cs = getCaseStudy('pharma-distribution-western-sydney');
const url = `${site.url}/case-studies/${cs.slug}/`;

const seo = {
  title: `${cs.label}: Ktronics case study`,
  description: cs.metaDescription,
  path: `/case-studies/${cs.slug}/`,
};

const breadcrumbs = breadcrumbSchema([
  { name: 'Home', url: `${site.url}/` },
  { name: 'Case Studies', url: `${site.url}/case-studies/` },
  { name: cs.label },
]);

// Article schema — Google + AI engines understand this as a case study /
// editorial piece. Keep "publisher" + "author" pointing at the org so it
// inherits the brand's E-E-A-T signals.
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: cs.title,
  description: cs.metaDescription,
  image: `${site.url}${cs.heroImage}`,
  author: { '@id': `${site.url}/#organization` },
  publisher: { '@id': `${site.url}/#organization` },
  mainEntityOfPage: url,
  about: cs.industry,
  contentLocation: { '@type': 'Place', name: cs.location },
};
---
<PageLayout seo={seo} schemaBlocks={[breadcrumbs, articleSchema]}>
  <CaseStudyHero caseStudy={cs} />
  <CaseStudyBody caseStudy={cs} />
  <CaseStudyStats stats={cs.stats} />
  <CaseStudyGallery images={cs.gallery} />

  {cs.testimonial && (
    <Testimonial
      quote={cs.testimonial.quote}
      role={cs.testimonial.role}
      organisation={cs.testimonial.organisation}
    />
  )}

  <CtaBlock
    heading="Got a project at this scale? <em>Let&apos;s walk the site.</em>"
    buttonText="Request a site assessment"
  />
</PageLayout>
