---
/**
 * /careers/ — Careers page.
 *
 * Composition:
 *   - Compact dark hero (page intent + lead)
 *   - "Why work at Ktronics" 4-up
 *   - Apprenticeship pathway block (Maya angle, dark)
 *   - Current openings — empty state for now (always-open expression-of-interest)
 *   - Application CTA block
 *
 * Apply path: handover spec called for a careers form with CV upload. For
 * launch, we keep it simple: applications go to sales@ktronics.com.au with
 * resume attached. Form-with-upload can be wired up post-launch when there's
 * an actual hiring round.
 */
import PageLayout from '@layouts/PageLayout.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import Button from '@components/ui/Button.astro';
import { breadcrumbSchema } from '@lib/schema';
import { site } from '@lib/site';

const seo = {
  title: 'Careers at Ktronics: Sydney Commercial Security Technicians',
  description:
    "Hiring commercial electronic security techs and apprentices in Sydney. Trade-led team, real on-site work. CV to sales@ktronics.com.au.",
  path: '/careers/',
};

const breadcrumbs = breadcrumbSchema([
  { name: 'Home', url: `${site.url}/` },
  { name: 'Careers' },
]);

const reasons = [
  {
    title: 'Trade-led, not sales-led.',
    body: "There is no separate sales team. The technicians who quote a job are the ones who design, install, and maintain it. You own the work end-to-end.",
  },
  {
    title: 'Real commercial work.',
    body: "From single-door access upgrades to multi-site CCTV rollouts. Lenel, Genetec, Avigilon, Tecom, Axis. The kind of jobs that make a CV worth reading.",
  },
  {
    title: 'Apprentice pathway.',
    body: "We hire apprentices alongside experienced techs. You'll work next to people with twenty-plus years on the tools, learning from them on real sites.",
  },
  {
    title: 'People stay.',
    body: 'Most of our team have been at Ktronics for years, not months. We hire deliberately and we look after the people we hire.',
  },
];
---
<PageLayout seo={seo} schemaBlocks={[breadcrumbs]}>
  {/* ----- Hero ----- */}
  <section class="careers-hero on-dark">
    <div class="container">
      <Eyebrow>Careers</Eyebrow>
      <h1 class="careers-hero-title">
        Want to do real commercial<br />
        security work in a team<br />
        that <em>stays put?</em>
      </h1>
      <p class="careers-hero-lead">
        Ktronics has been doing electronic security in Sydney since 2003.
        We hire deliberately, train properly, and keep people for a long
        time. If you&apos;re an experienced technician or an apprentice
        looking for somewhere to grow, we&apos;d like to hear from you.
      </p>
    </div>
  </section>

  {/* ----- Why Ktronics ----- */}
  <section class="reasons">
    <div class="container">
      <div class="reasons-header reveal">
        <Eyebrow>Why Ktronics</Eyebrow>
        <h2 class="reasons-heading">Four things you should know.</h2>
      </div>

      <div class="reasons-grid reveal">
        {reasons.map((r, i) => (
          <article class="reason">
            <span class="reason-num">0{i + 1}</span>
            <h3 class="reason-title">{r.title}</h3>
            <p class="reason-body">{r.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ----- Current openings ----- */}
  <section class="openings on-dark">
    <div class="container">
      <div class="openings-grid">
        <div class="openings-text">
          <Eyebrow>Current openings</Eyebrow>
          <h2 class="openings-heading">No specific roles open right now.</h2>
          <p class="openings-body">
            We don&apos;t advertise hiring rounds because we don&apos;t hire on
            a schedule. When the right person turns up, we make space. If you
            think that might be you, send your CV through. We read every one
            and we&apos;ll be in touch when there&apos;s a fit.
          </p>
        </div>

        <aside class="openings-apply">
          <h3 class="apply-heading">How to apply</h3>
          <p class="apply-body">
            Email your CV and a few lines about what you&apos;re looking for to:
          </p>
          <a class="apply-email" href={`mailto:${site.contact.email}?subject=Careers%20enquiry`}>
            {site.contact.email}
          </a>
          <p class="apply-meta">
            We&apos;ll get back to you within one business week. If we don&apos;t
            have anything immediate, we&apos;ll keep your details on file.
          </p>
        </aside>
      </div>
    </div>
  </section>

  {/* ----- Closing CTA ----- */}
  <section class="careers-cta-section">
    <div class="container">
      <div class="careers-cta reveal">
        <h2 class="careers-cta-heading">
          Not sure if you&apos;re a fit? <em>Reach out anyway.</em>
        </h2>
        <p class="careers-cta-body">
          The worst thing that happens is we have a conversation. Best case,
          we find a spot for someone we&apos;d otherwise have missed.
        </p>
        <Button href={`mailto:${site.contact.email}?subject=Careers%20enquiry`} variant="primary">
          Send your CV
        </Button>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  /* ---------- Hero ---------- */
  .careers-hero {
    background: var(--bg-dark);
    color: var(--fg-on-dark);
    padding-block: clamp(64px, 8vw, 112px);
  }
  .careers-hero-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.04em;
    margin: 16px 0 24px;
    color: var(--fg-on-dark);
    text-wrap: balance;
  }
  .careers-hero-title em {
    font-style: italic;
    font-weight: 500;
    color: var(--ktx-red);
  }
  .careers-hero-lead {
    color: var(--fg-mute-on-dark);
    font-size: var(--t-lead);
    line-height: 1.6;
    max-width: 60ch;
    margin: 0;
  }

  /* ---------- Reasons grid ---------- */
  .reasons { padding-block: clamp(80px, 10vw, 128px); }
  .reasons-header {
    margin-bottom: 56px;
    max-width: 60ch;
  }
  .reasons-heading {
    margin: 16px 0 0;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.035em;
  }
  .reasons-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: 1px solid var(--ktx-line);
    border-left: 1px solid var(--ktx-line);
  }
  .reason {
    border-right: 1px solid var(--ktx-line);
    border-bottom: 1px solid var(--ktx-line);
    padding: 32px 28px;
    background: var(--bg-alt);
  }
  .reason-num {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--accent-text);
    margin-bottom: 16px;
    display: block;
  }
  .reason-title {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    margin: 0 0 12px;
    line-height: 1.3;
  }
  .reason-body {
    color: var(--ktx-ink-soft);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0;
  }
  @media (max-width: 900px) {
    .reasons-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .reasons-grid { grid-template-columns: 1fr; }
  }

  /* ---------- Openings ---------- */
  .openings {
    background: var(--bg-dark);
    color: var(--fg-on-dark);
    padding-block: clamp(80px, 10vw, 128px);
  }
  .openings-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .openings-heading {
    color: var(--fg-on-dark);
    margin: 16px 0 24px;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.035em;
  }
  .openings-body {
    color: var(--fg-mute-on-dark);
    font-size: var(--t-lead);
    line-height: 1.6;
    margin: 0;
  }
  .openings-apply {
    border-top: 2px solid var(--ktx-red);
    padding-top: 28px;
  }
  .apply-heading {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-mute-on-dark);
    margin: 0 0 16px;
    font-weight: 500;
  }
  .apply-body {
    color: var(--fg-mute-on-dark);
    font-size: 0.9375rem;
    margin: 0 0 12px;
  }
  .apply-email {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 1.0625rem;
    color: var(--fg-on-dark);
    border-bottom: 1px solid var(--rule-on-dark);
    padding-bottom: 2px;
    margin-bottom: 24px;
    transition: color 0.18s ease, border-color 0.18s ease;
  }
  .apply-email:hover { color: var(--ktx-red); border-color: var(--ktx-red); }
  .apply-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--fg-mute-on-dark);
    margin: 0;
  }
  @media (max-width: 900px) {
    .openings-grid { grid-template-columns: 1fr; gap: 48px; }
  }

  /* ---------- Closing CTA ---------- */
  .careers-cta-section { padding-block: clamp(72px, 9vw, 112px); }
  .careers-cta {
    max-width: 60ch;
    margin: 0 auto;
    text-align: center;
    padding-top: 48px;
    border-top: 1px solid var(--ktx-line);
  }
  .careers-cta-heading {
    margin: 0 0 16px;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .careers-cta-heading em {
    font-style: italic;
    font-weight: 500;
    color: var(--ktx-red);
  }
  .careers-cta-body {
    color: var(--ktx-ink-soft);
    font-size: var(--t-lead);
    line-height: 1.6;
    margin: 0 0 32px;
  }
</style>
