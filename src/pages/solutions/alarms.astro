---
/**
 * /solutions/alarms/
 * See access-control.astro for the full composition + schema rationale.
 */
import PageLayout from '@layouts/PageLayout.astro';
import SolutionHero from '@components/sections/SolutionHero.astro';
import Capabilities from '@components/sections/Capabilities.astro';
import HowItWorks from '@components/sections/HowItWorks.astro';
import Faqs from '@components/sections/Faqs.astro';
import RelatedSolutions from '@components/sections/RelatedSolutions.astro';
import CtaBlock from '@components/sections/CtaBlock.astro';
import { breadcrumbSchema, faqPageSchema, serviceSchema } from '@lib/schema';
import { getSolution } from '@lib/solutions';
import { site } from '@lib/site';

const solution = getSolution('alarms');
const url = `${site.url}/solutions/${solution.slug}/`;

const seo = {
  title: `${solution.pageTitle} | Ktronics`,
  description:
    "Commercial intrusion alarm systems in Sydney: PIR, dual-tech, perimeter, duress. Bosch, Inner Range, Tecom Challenger panels. 24/7 verified back-to-base monitoring.",
  path: `/solutions/${solution.slug}/`,
};

const breadcrumbs = breadcrumbSchema([
  { name: 'Home', url: `${site.url}/` },
  { name: 'Solutions', url: `${site.url}/solutions/` },
  { name: solution.label },
]);

const service = serviceSchema({
  serviceType: 'Commercial Alarm System Installation',
  description: solution.heroLead,
  url,
});

const faqSchema = faqPageSchema(solution.faqs);
---
<PageLayout seo={seo} schemaBlocks={[breadcrumbs, service, faqSchema]}>
  <SolutionHero solution={solution} />
  <Capabilities items={solution.capabilities} />
  <HowItWorks steps={solution.process} />
  <Faqs items={solution.faqs} eyebrow="Common questions" heading="Frequently asked." />
  <RelatedSolutions currentSlug={solution.slug} />
  <CtaBlock
    heading="Tired of false alarms? <em>Let&apos;s redesign the system.</em>"
    buttonText="Request a site assessment"
  />
</PageLayout>
